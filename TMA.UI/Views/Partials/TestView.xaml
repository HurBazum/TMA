<UserControl x:Class="TMA.UI.Views.Partials.TestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mdt="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv ="clr-namespace:TMA.UI.Infrastructure.Converters">

    <StackPanel Width="400" Height="200"
                VerticalAlignment="Center" Margin="20"
                Background="#FF76767F">
        <TextBlock Padding="10" Text="Block" x:Name="tb" Tag="{RelativeSource Self}" />
        <RadioButton Margin="5">
            <RadioButton.Content>
                <MultiBinding Converter="{StaticResource testConverter}">
                    <Binding ElementName="tb" Path="Text" />
                    <Binding ElementName="rb2" Path="Content" />
                </MultiBinding>
            </RadioButton.Content>
        </RadioButton>
        <RadioButton Margin="5" Content="second" x:Name="rb2" />
    </StackPanel>
</UserControl>
