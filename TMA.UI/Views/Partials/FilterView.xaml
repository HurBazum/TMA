<UserControl x:Class="TMA.UI.Views.Partials.FilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMA.UI.Views.Partials"
             mc:Ignorable="d" 
             d:DesignHeight="250" d:DesignWidth="800" d:Background="AliceBlue">
    <Grid Background="#FF76767F">
        <Grid.RowDefinitions>
            <RowDefinition Height="100" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.Resources>
            <Style TargetType="{x:Type RadioButton}">
                <Setter Property="Command" Value="{Binding GetFilterFilter}" />
            </Style>
        </Grid.Resources>
        
        <StackPanel Orientation="Horizontal"
                    Height="70"
                    Grid.Row="0" >
            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                     Width="200"
                     Style="{StaticResource mytxt}"
                     Margin="10, 5"
                     Padding="5"
                     FontFamily="Bookman Old Style" />
            <Button Style="{StaticResource MinOpBtn}" Content="Search" Command="{Binding UseFilterCmd}" />
            <Button Style="{StaticResource MinOpBtn}" Content="More" Command="{Binding UseAllFiltersCmd}" />
        </StackPanel>
        <StackPanel x:Name="MoreFilters" Grid.Row="1" Visibility="{Binding IsAllFilterUse, Converter={StaticResource visibilityConverter}}" Margin="10" >
            <StackPanel>
                <TextBlock Text="Priority" TextAlignment="Center" />
                <RadioButton Content="None" CommandParameter="Priority_None" />
                <RadioButton Content="Normal" CommandParameter="Priority_Normal" />
                <RadioButton Content="Medium" CommandParameter="Priority_Medium" />
                <RadioButton Content="High" CommandParameter="Priority_High" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Status" TextAlignment="Center" />
                <RadioButton Content="None" CommandParameter="Status_None" />
                <RadioButton Content="Pending" CommandParameter="Status_Pending" />
                <RadioButton Content="Completed" CommandParameter="Status_Completed" />
                <RadioButton Content="Expired" CommandParameter="Status_Expired" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
