 <UserControl x:Class="TMA.UI.Views.Partials.TaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMA.UI.Views.Partials"
             xmlns:conv="clr-namespace:TMA.UI.Infrastructure.Converters"
              xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#055987" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Style="{StaticResource MinOpBtn}"
                Command="{Binding GoBackCmd}" />
        <TextBox x:Name="titleTxt"
                 Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}"
                 Padding="10" MaxLines="2"
                 Height="100" FontSize="16" FontWeight="DemiBold"
                 Grid.Column="1" Grid.ColumnSpan="4"
                 Grid.Row="1" />
        <StackPanel VerticalAlignment="Center"
                    Grid.ColumnSpan="2"
                    Grid.Column="2"
                    Grid.Row="2">
            <TextBlock Width="150" Height="50"
                       Background="NavajoWhite"
                       Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" 
                       FontSize="32" FontWeight="ExtraBlack"
                       TextAlignment="Center">
                <TextBlock.InputBindings>
                    <MouseBinding MouseAction="LeftClick" 
                                  Command="{Binding ChangeValueCmd}" CommandParameter="Priority_Decrement" />
                    <MouseBinding MouseAction="RightClick"
                                  Command="{Binding ChangeValueCmd}" CommandParameter="Priority_Increment" />
                </TextBlock.InputBindings>
            </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Grid.Row="3"
                    Margin="0 0 0 0">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource GreenBtn}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUpdate}" Value="True">
                            <Setter Property="Command" Value="{Binding UpdateTaskCmd}" />
                            <Setter Property="Content" Value="Update" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsUpdate}" Value="False">
                            <Setter Property="Command" Value="{Binding AddTaskCmd}" />
                            <Setter Property="Content" Value="Add" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Resources>
            <Button />
        </StackPanel>
        <StackPanel Orientation="Vertical" 
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="120"
                    Grid.Row="2"
                    Grid.RowSpan="2"
                    Grid.Column="4">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Deadline" 
                           TextAlignment="Center" FontSize="16"
                           FontWeight="ExtraBold"
                           Padding="10 0 5 0"/>
                <CheckBox Style="{StaticResource ccb}"
                    IsChecked="{Binding IsLimited}" />
            </StackPanel>
        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="{x:Type Button}">
                        <Setter Property="Height" Value="15" />
                        <Setter Property="Width" Value="26" />
                        <Setter Property="Background" Value="#FF7EC1DE" />
                    </Style>
                    
                    <Style TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Center" />
                    </Style>
                </StackPanel.Resources>
                    <Viewbox>
                        <StackPanel>
                            <Button Command="{Binding ChangeValueCmd}" CommandParameter="Day_Decrement" />
                            <TextBlock Text="{Binding Deadline.Day, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding ChangeValueCmd}" CommandParameter="Day_Increment" />
                        </StackPanel>
                    </Viewbox>
                    <Viewbox>
                        <StackPanel>
                            <Button Width="55" Command="{Binding ChangeValueCmd}" CommandParameter="Month_Decrement" />
                            <TextBlock Text="{Binding Deadline.Month, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource monthsConverter}}" />
                            <Button Width="55" Command="{Binding ChangeValueCmd}" CommandParameter="Month_Increment" />
                        </StackPanel>
                    </Viewbox>
                    <Viewbox>
                        <StackPanel>
                            <Button Command="{Binding ChangeValueCmd}" CommandParameter="Year_Decrement" />
                            <TextBlock Text="{Binding Deadline.Year, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Command="{Binding ChangeValueCmd}" CommandParameter="Year_Increment" />
                        </StackPanel>
                    </Viewbox>
                </StackPanel>
            </StackPanel>

        <Popup IsOpen="True"
               PlacementTarget="{Binding ElementName=MainGrid}"
               Placement="Bottom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Focusable="True"
               StaysOpen="False"
               VerticalOffset="-40">
            <Border BorderThickness="1"
                        CornerRadius="5">
                <TextBlock Text="{Binding Message}"
                               Background="DarkKhaki"
                               FontSize="16"
                               Padding="10"
                               FontWeight="ExtraBlack">
                </TextBlock>
            </Border>
            
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="GotFocus">
                    <i:ChangePropertyAction PropertyName="IsOpen" Value="False" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Popup>
    </Grid>
</UserControl>
