<UserControl x:Class="TMA.UI.Views.Partials.TaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMA.UI.Views.Partials"
             xmlns:conv="clr-namespace:TMA.UI.Infrastructure.Converters"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:controls="clr-namespace:TMA.UI.Views.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Background="#FF76767F" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Button Content="Back"
                Style="{StaticResource MinOpBtn}"
                Command="{Binding GoBackCmd}" />
        <TextBox x:Name="titleTxt"
                 Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}"
                 Style="{StaticResource bigBox}"
                 MaxLines="2"
                 Height="70" 
                 Grid.Column="1" 
                 Grid.ColumnSpan="4"
                 Grid.Row="1" />
        <StackPanel VerticalAlignment="Center"
                    Grid.ColumnSpan="2"
                    Grid.Column="2"
                    Grid.Row="2">
            <TextBlock Width="150" Height="50"
                       Background="NavajoWhite"
                       Text="{Binding Priority, UpdateSourceTrigger=PropertyChanged, Mode=OneWay}" 
                       FontSize="32" FontWeight="ExtraBlack"
                       TextAlignment="Center">
                <TextBlock.InputBindings>
                    <MouseBinding MouseAction="LeftClick" 
                                  Command="{Binding ChangeValueCmd}" CommandParameter="Priority_Decrement" />
                    <MouseBinding MouseAction="RightClick"
                                  Command="{Binding ChangeValueCmd}" CommandParameter="Priority_Increment" />
                </TextBlock.InputBindings>
            </TextBlock>
        </StackPanel>
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Grid.Column="1"
                    Grid.ColumnSpan="4"
                    Grid.Row="3"
                    Margin="0 0 0 0">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource MinOpBtn}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUpdate}" Value="True">
                            <Setter Property="Command" Value="{Binding UpdateTaskCmd}" />
                            <Setter Property="Content" Value="Update" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsUpdate}" Value="False">
                            <Setter Property="Command" Value="{Binding AddTaskCmd}" />
                            <Setter Property="Content" Value="Add" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Resources>
            <Button />
        </StackPanel>
        <StackPanel Grid.Row="3"
                    Grid.RowSpan="2"
                    Grid.Column="4"
                    Grid.ColumnSpan="2">
            <controls:DateWorker Date="{Binding Deadline}"
                                 Cmd="{Binding UniversalDateCmd}"
                                 Limit="{Binding IsLimited}"
                                 Background="Transparent"
                                 Header="Deadline"
                                 Margin="11"/>
        </StackPanel>
    </Grid>
</UserControl>