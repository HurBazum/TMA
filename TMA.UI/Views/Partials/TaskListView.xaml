<UserControl x:Class="TMA.UI.Views.Partials.TaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMA.UI.Views.Partials"
             xmlns:models="clr-namespace:TMA.UI.Models"
             xmlns:v="clr-namespace:TMA.UI.Views.Partials"
             mc:Ignorable="d" 
             d:DesignHeight="610" d:DesignWidth="800" d:Background="Azure"
             Height="570">
    <Grid Background="#FF76767F" x:Name="MainGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="90" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" 
                        VerticalAlignment="Top" 
                        Content="{Binding FilterViewModel}" />

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding TVMs}"
                 SelectedItem="{Binding SelectedTask}">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type models:TaskViewModel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition MinHeight="50" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="150" />
                            <ColumnDefinition MinWidth="150" />
                            <ColumnDefinition MinWidth="150" />
                            <ColumnDefinition MinWidth="150" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="{Binding Id}"
                                   Visibility="Collapsed" />

                        <StackPanel HorizontalAlignment="Center"
                                    Grid.Column="0">
                            <TextBlock Text="{Binding CreatedDate}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    Grid.Column="1">
                            <TextBlock Text="{Binding Deadline}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Grid.Row="0" Grid.Column="2">
                            <StackPanel.Resources>
                                <Style TargetType="{x:Type RadioButton}">
                                    <Setter Property="Height" Value="15" />
                                    <Setter Property="Width" Value="15" />
                                    <Setter Property="IsEnabled" Value="False" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="RadioButton">
                                                <Border x:Name="brdr"
                                                        BorderBrush="{TemplateBinding Background}"
                                                        CornerRadius="3"
                                                        Background="{TemplateBinding Background}">
                                                    <ContentPresenter x:Name="cPresenter" />
                                                </Border>

                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="False">
                                                        <Setter Property="Opacity" Value="0.37" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>

                            <RadioButton IsChecked="{Binding PDictionary[0], Mode=TwoWay}"
                                         Background="#FF71AF60" />
                            <RadioButton IsChecked="{Binding PDictionary[1], Mode=TwoWay}"
                                         Background="#FFDAD322" />
                            <RadioButton IsChecked="{Binding PDictionary[2], Mode=TwoWay}"
                                         Background="#FFC14848" />
                        </StackPanel>

                        <TextBlock Text="{Binding Title}"
                                   MinWidth="300"
                                   Width="600"
                                   Padding="10, 5"
                                   Grid.ColumnSpan="3"
                                   Grid.Row="1" />
                        <StackPanel Grid.Row="1" Grid.Column="3" 
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <CheckBox Style="{StaticResource ccb}"
                                      IsChecked="{Binding Completed, Mode=OneWay}"
                                      Command="{Binding DataContext.CompleteTaskCmd, 
                                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                      CommandParameter="{Binding Mode=OneWay}" />
                        </StackPanel>
                        <Button Content="Update"
                                Style="{StaticResource MinOpBtn}"
                                Command="{Binding DataContext.UpdateTaskCmd, 
                                                    RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding Mode=OneWay}" 
                                Grid.Column="3" Grid.Row="2" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="12" Grid.Row="2" >
            <StackPanel.Resources>
                <Style TargetType="{x:Type RadioButton}">
                    <Setter Property="Command" Value="{Binding SetFilterValueCmd}" />
                </Style>
            </StackPanel.Resources>
            <Button Content="Create task"
                    Style="{StaticResource MinOpBtn}"
                    Command="{Binding CreateTVMCmd}" 
                    RenderTransformOrigin="0.478,-0.862" />
        </StackPanel>
        <Popup IsOpen="{Binding HasMessage}"
               PlacementTarget="{Binding ElementName=MainGrid}"
               Placement="Bottom"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Focusable="True"
               StaysOpen="False"
               VerticalOffset="-40"
               MinHeight="25" MinWidth="25">
            <Border CornerRadius="5"
                    Background="Bisque">
                <Label Content="{Binding Message}"
                       Style="{StaticResource ntfctn}"
                       Margin="5" />
            </Border>

            <i:Interaction.Triggers>
                <i:EventTrigger EventName="GotFocus">
                    <i:ChangePropertyAction PropertyName="IsOpen" Value="False" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </Popup>
    </Grid>
</UserControl>