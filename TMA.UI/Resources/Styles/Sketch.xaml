             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TMA.UI.Resources.Styles"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="400" d:Height="400" d:Background="AliceBlue">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="14*"/>
            <RowDefinition Height="31*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Rectangle Width="250" Height="80" Grid.ColumnSpan="2" Stroke="Magenta" StrokeThickness="7" RadiusX="50" RadiusY="50" Margin="75,45,75,185" Grid.Row="1" />
        <Ellipse StrokeThickness="3" Stroke="DarkOrchid" Grid.Column="0" RenderTransformOrigin="1.65,0.5" Margin="100,64,60,207" Grid.Row="1" />
    </Grid>
</UserControl>
